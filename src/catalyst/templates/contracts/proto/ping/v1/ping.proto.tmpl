syntax = "proto3";

package ping.v1;

// Use a generic path for the shared contracts repo. 
// Backends will override this using Buf Managed Mode.
option go_package = "{{ .ProjectName }}/ping/v1;pingv1";

service PingService {
  rpc Ping(PingRequest) returns (PingResponse) {}
}

message PingRequest {
  string message = 1;
}

message PingResponse {
  string response = 1;
}
