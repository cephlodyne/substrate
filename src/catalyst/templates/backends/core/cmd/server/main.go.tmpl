package main

import (
	"context"
	"log/slog"
	"os"
	{{- if or .Features.HasIAPAuth .Features.HasSvelteUI }}
	"net/http"
	{{- end }}
	{{- if .Features.HasSvelteUI }}
	"io/fs"
	"log"
	{{- end }}

	"github.com/cephlodyne/kit/api"
	"github.com/cephlodyne/kit/ev"
{{- if .Features.HasPostgres }}
	"github.com/cephlodyne/kit/pg"
{{- end }}
	"github.com/cephlodyne/kit/runner"
	"github.com/cephlodyne/kit/trail"
	{{- if .Features.HasIAPAuth }}
	"github.com/cephlodyne/kit/auth"
	{{- end }}

{{- if .Features.HasConnectRPC }}
	// "{{ .ProjectName }}/internal/ping" // Uncomment once buf generate succeeds
{{- end }}
{{- if .Features.HasSvelteUI }}
	"{{ .ProjectName }}/frontend"
{{- end }}
)

{{ if .Features.HasIAPAuth }}
// DefaultChecker is a placeholder RBAC implementation
type DefaultChecker struct{}

func (c *DefaultChecker) HasPermission(ctx context.Context, identity, permission string) (bool, error) {
	return true, nil
}
{{ end }}

func main() {
	// 1. Initialize environment and structured logging
	isCloud := ev.IsCloud()
	isProd := ev.IsProd()
	trail.Setup(isCloud, isProd)

	ctx := context.Background()
	slog.Info("Booting {{ .ProjectName }} backend...")

{{- if .Features.HasPostgres }}
	// 2. Database Connection (Fixed pg.Config struct)
	dsn := ev.GetOptional("DB_MAIN_DSN", "postgres://{{ .ProjectName }}_sa:local-dev-password@localhost:5432/{{ .ProjectName }}_main?sslmode=disable")
	pool, err := pg.Connect(ctx, pg.Config{DSN: dsn})
	if err != nil {
		slog.Error("failed to connect to database", "err", err)
		os.Exit(1)
	}
	defer pool.Close()
	slog.Info("✅ Successfully connected to Postgres!")
{{- end }}
  // 3. Initialize API Multiplexer
	mux := api.NewMux()

{{- if .Features.HasConnectRPC }}
	// pingPath, pingHandler := ping.NewHandler()
	// mux.Handle(pingPath, pingHandler)
{{- end }}

{{- if .Features.HasIAPAuth }}
	// --- IAP Authentication Setup ---
	authenticator := &auth.Authenticator{
		Audience:    ev.GetOptional("IAP_AUDIENCE", ""),
		IsCloud:     isCloud,
		DevOverride: "dev-user@cephlodyne.com",
		Checker:     &DefaultChecker{}, // TODO: Replace with auth.NewSQLChecker(pool, log)
	}
	
	mux.HandleFunc("GET /api/v1/me", authenticator.RequireAny(api.AppHandler(handleGetIdentity).ServeHTTP, "internal-access"))
{{- end }}

{{- if .Features.HasSvelteUI }}
	frontendFS, err := fs.Sub(frontend.FS, "dist")
	if err != nil {
		log.Fatal("failed to load embedded frontend filesystem: ", err)
	}
	mux.Handle("/", http.FileServer(http.FS(frontendFS)))
{{- end }}

	// 4. Start Server with graceful shutdown
	runner.Serve(mux)
}

{{ if .Features.HasIAPAuth }}
// handleGetIdentity exposes the underlying identity from the IAP JWT
func handleGetIdentity(w http.ResponseWriter, r *http.Request) error {
	identity, ok := r.Context().Value(auth.IdentityKey).(string)
	if !ok || identity == "" {
		return api.NewError(http.StatusUnauthorized, "Unauthorized", "No valid identity found.")
	}

	w.Header().Set("Content-Type", "application/json")
	// Using a raw byte write removes the need for the encoding/json import
	_, err := w.Write([]byte(`{"email":"` + identity + `"}`))
	return err
}
{{ end }}
