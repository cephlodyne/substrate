version: v2
plugins:
  # --- Go Backend Plugins ---
  - local: protoc-gen-go
    out: pkg/pb
    opt: paths=source_relative
  - local: protoc-gen-connect-go
    out: pkg/pb
    opt: paths=source_relative

{{- if .Features.HasSvelteUI }}
  # --- TypeScript Frontend Plugins ---
  - local: protoc-gen-es
    out: frontend/src/lib/pb
    opt: target=ts
  - local: protoc-gen-connect-es
    out: frontend/src/lib/pb
    opt: target=ts
{{- end }}
