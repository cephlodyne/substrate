version: v2
managed:
  enabled: true
  override:
    - file_option: go_package_prefix
      value: {{ .ProjectName }}/pkg/pb
    - file_option: go_package
      value: github.com/cephlodyne/kit/auth/pb
      path: auth/v1/auth.proto
plugins:
  # --- Go Backend Plugins ---
  - local: protoc-gen-go
    out: pkg/pb
    opt: paths=source_relative
  - local: protoc-gen-connect-go
    out: pkg/pb
    opt: paths=source_relative

{{- if .Features.HasSvelteUI }}
  # --- TypeScript Frontend Plugins ---
  - local: protoc-gen-es
    out: frontend/src/lib/pb
    opt: target=ts
{{- end }}
