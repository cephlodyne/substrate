# syntax=docker/dockerfile:1.4
ARG GO_IMAGE
{{- if .Features.HasSvelteUI }}
ARG NODE_IMAGE
{{- end }}

{{ if .Features.HasSvelteUI }}
# --- Stage 1: UI Build (Offline) ---
FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS ui-builder
WORKDIR /app/frontend

COPY frontend/package.json frontend/pnpm-lock.yaml ./
COPY frontend/ ./
RUN FRONTENDS="." strata-build-node

{{- end }}

# --- Stage 2: Go Build (Vendored) ---
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS go-builder
WORKDIR /app

# Pull in target architecture variables generated automatically by Docker
ARG TARGETOS
ARG TARGETARCH

COPY go.mod go.sum ./
COPY vendor/ vendor/
COPY . .

{{- if .Features.HasSvelteUI }}
COPY --from=ui-builder /app/frontend/dist ./frontend/dist
{{- end }}

# Delegate exact compliance checks and compilation to the Golden Image
ENV GO_ENTRYPOINTS="cmd/server"
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/.cache/govulncheck \
    strata-build-go

# --- Stage 3: Final Minimal Runtime ---
FROM scratch
COPY --from=go-builder /etc/passwd /etc/passwd
COPY --from=go-builder /app/server /server
USER appuser
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/server"]
