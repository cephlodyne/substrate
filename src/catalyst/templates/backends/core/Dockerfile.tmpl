# syntax=docker/dockerfile:1.4
ARG GO_IMAGE
{{- if .Features.HasFrontend }}
ARG NODE_IMAGE
{{- end }}

{{ if .Features.HasFrontend }}
# --- Stage 1: UI Build (Golden Image) ---
FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS ui-builder
WORKDIR /app

COPY frontend/ ./frontend/

ARG NPM_TOKEN
ARG OFFLINE_BUILD=false
ENV OFFLINE_BUILD=${OFFLINE_BUILD}
ENV FRONTENDS="frontend"

# Write the token to the user-level /root/.npmrc (unquoted) so pnpm v12 trusts it
RUN echo "{{ .NPMAuthPath }}:_authToken=${NPM_TOKEN}" > /root/.npmrc

RUN strata-build-node
{{- end }}

# --- Stage 2: Go Build (Vendored) ---
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS go-builder
WORKDIR /app

ARG TARGETOS
ARG TARGETARCH

COPY go.mod go.sum ./
COPY vendor/ vendor/
COPY . .

{{- if .Features.HasFrontend }}
COPY --from=ui-builder /app/frontend/dist ./frontend/dist
{{- end }}

ENV GO_ENTRYPOINTS="cmd/server"
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/.cache/govulncheck \
    strata-build-go

# --- Stage 3: Final Minimal Runtime ---
FROM scratch
COPY --from=go-builder /etc/passwd /etc/passwd
COPY --from=go-builder /app/bin/server /server
USER appuser
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/server"]
