.PHONY: setup build run dev audit

setup:
{{- if .Features.HasConnectRPC }}
	@echo "Generating RPC Contracts..."
	buf generate {{ .ContractsDir }} --template buf.gen.yaml
{{- end }}
	@echo "Syncing Go dependencies..."
	go mod tidy
	@echo "Vendoring dependencies for zero-trust builds..."
	GOWORK=off go mod vendor
{{- if .Features.HasSvelteUI }}
	@echo "Syncing Node dependencies..."
	cd frontend && npm_config_offline=false pnpm install
	@echo "Ensuring frontend dist directory exists for go:embed..."
	mkdir -p frontend/dist && touch frontend/dist/.keep
{{- end }}

audit:
	@echo "🔍 Running Go Vulnerability Check..."
	go run golang.org/x/vuln/cmd/govulncheck@latest ./...
{{- if .Features.HasSvelteUI }}
	@echo "🔍 Running Frontend Dependency Audit..."
	cd frontend && pnpm audit
{{- end }}

build: audit
{{- if .Features.HasSvelteUI }}
	cd frontend && pnpm build
{{- end }}
	go build -mod=vendor -o bin/server ./cmd/server

run: build
	./bin/server

dev: setup
{{- if .Features.HasSvelteUI }}
	@echo "Starting rapid local development environment..."
	@bash -c "trap 'kill %1' SIGINT; go run ./cmd/server/main.go & cd frontend && pnpm dev"
{{- else }}
	go run ./cmd/server/main.go
{{- end }}
